{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":semanticCommitsDisabled"],
  "labels": ["renovate"],
  "timezone": "Europe/Stockholm",
  "schedule": ["before 7am on monday"],
  "minimumReleaseAge": "7 days",
  "prConcurrentLimit": 5,
  "vulnerabilityAlerts": { "labels": ["renovate", "security"], "minimumReleaseAge": null, "schedule": ["at any time"] },
  "packageRules": [
    {
      "description": "Digest and patch bumps merge themselves once CI is green. Everything else waits for a person.",
      "matchUpdateTypes": ["digest", "pin", "pinDigest", "patch"],
      "automerge": false
    },
    {
      "description": "Never automerge: supply-chain history, data stores, SSO, object storage.",
      "matchPackageNames": ["/litellm/", "/goauthentik/", "/postgres/", "/minio/", "/clickhouse/", "/redis/"],
      "automerge": false,
      "addLabels": ["needs-human"]
    },
    {
      "description": "authentik supports one release at a time: never propose a jump over a minor.",
      "matchPackageNames": ["/goauthentik/"],
      "separateMultipleMinor": true,
      "separateMinorPatch": true
    }
  ]
}
