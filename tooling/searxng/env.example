# Copy to `.env` next to compose.yml (gitignored) and fill in:
#     cp env.example .env
# (Kept as `env.example`, not `.env.example`: the sandbox's FUSE filter hard-denies
# every `.env*` path at any depth, so a dotted name cannot be edited from inside a
# sandbox at all.)

# Instance secret. Generate with:  openssl rand -hex 32
SEARXNG_SECRET=

# Public URL the instance is reached at (through your reverse proxy). Used for
# absolute links; must match what the sandbox is pointed at with --search-url.
SEARXNG_BASE_URL=https://searxng.example.com/

# Host-local port the container publishes (your reverse proxy targets this).
SEARXNG_PORT=8888
