# Reference for the compose env file — NOT a file you copy or edit.
#
# (Named env.example, not .env.example: the sandbox FUSE filter hard-denies `.env*`
#  at any depth, so a dotted name is invisible to the agent inside the sandbox.)
#
# `sandbox up` GENERATES this per sandbox at
#     ${XDG_STATE_HOME:-~/.local/state}/sandbox/sandboxes/<name>/env
# and every later compose call is pointed at it with `--env-file` (see compose_bind).
# Compose no longer picks up `.devcontainer/.env` implicitly — per-sandbox state moved
# out of the install tree so the CLI can be installed rather than run from a checkout.
# A pre-install `.devcontainer/.env` is migrated to the path above on first run.
#
# Listed here so the keys compose.yaml consumes are documented somewhere readable.

# Per-sandbox identity (also exported as COMPOSE_PROJECT_NAME by the CLI).
SANDBOX_NAME=cc-sandbox

# Host path of the repo/worktree to expose (the FUSE filter reads from here).
SANDBOX_SOURCE=/home/you/dev/myrepo

# Host path of the FUSE-filtered view (the workload binds this at /workspace).
# Under /run/user/<uid> when there is a login session, else <state>/run.
SANDBOX_MOUNT=/run/user/1000/devfilter/cc-sandbox

# Pinned Claude Code version (or "latest").
CLAUDE_CODE_VERSION=latest

# Bind-mounted into the gateway as /run/broker-control: broker socket, request log,
# webui password, and the flywheel capture DIRECTORY. Not shared with the workload.
BROKER_CONTROL_DIR=/home/you/.local/state/sandbox/sandboxes/cc-sandbox/control

# Shared Minions checkout mounted into the container.
MINIONS_DIR=/home/you/dev/Minions

# Egress: 1 bypasses the proxy and the allowlist entirely (no MITM).
ALLOW_INTERNET=0
# Per-sandbox allowlist, hot-reloaded by broker_addon.py on change.
ALLOWLIST_FILE=/home/you/.local/state/sandbox/sandboxes/cc-sandbox/allowlist.txt
# 1 records every LLM call, UNREDACTED, into $BROKER_CONTROL_DIR/flywheel/.
FLYWHEEL=0

# Workload resource ceiling and FUSE ownership (see --cpus/--memory/--fs-uid).
SANDBOX_CPUS=4
SANDBOX_MEMORY=8g
SANDBOX_FS_UID=1000
SANDBOX_FS_GID=1000

# Lane policy and wall-clock lifetime, enforced by `sandbox reap`.
SANDBOX_POLICY=
SANDBOX_LANE=
SANDBOX_STARTED_AT=1756483200
SANDBOX_TTL_MINUTES=
SANDBOX_RUN_ID=

# Published dev-server port (declared on the gateway service). host:container,
# host-local. Auto-assigned from 3000 unless `up --port HOST:CTR` pins it.
FORWARD_SPEC=127.0.0.1:3000:3000

# Appended by harness_home_env_lines(): SANDBOX_CLAUDE_HOME, SANDBOX_PI_HOME,
# SANDBOX_OMP_HOME, SANDBOX_PRIME_HOME — the shared per-harness home dirs.
